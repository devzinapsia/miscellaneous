<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.email.template.style</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <div id="email_template_style">
                    <block title="Estilo de Emails" name="email_template_style_setting_container">
                        <setting id="email_template_style_setting" string="Estilo de emails" help="Aplica un texto y una firma distintos a los emails de factura, nota de crédito, pago, cotización y orden de venta">
                            <field name="email_template_style" class="o_light_label" widget="radio"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
