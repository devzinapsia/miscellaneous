<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ypf_import_wizard_form" model="ir.ui.view">
        <field name="name">ypf.import.wizard.form</field>
        <field name="model">ypf.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Nueva factura YPF Ruta">
                <sheet>
                    <group>
                        <group string="Información del Proveedor">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Fechas">
                            <field name="invoice_date"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <group>
                        <field name="excel_file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                        <field name="group_type" widget="radio"/>
                        <field name="use_analytic_domain"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Aceptar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ypf_import_wizard" model="ir.actions.act_window">
        <field name="name">Nueva factura YPF Ruta</field>
        <field name="res_model">ypf.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

