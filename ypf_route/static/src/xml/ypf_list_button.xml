<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ypf_route.AccountMoveListView.Buttons" t-inherit="account.AccountMoveListView.Buttons" t-inherit-mode="extension">
        <xpath expr="." position="inside">
            <button
                t-if="showYpfButton"
                type="button"
                class="btn btn-secondary o_button_ypf_import"
                t-on-click="() => this.onClickNuevaFacturaYPF()">
                Nueva factura de YPF
            </button>
        </xpath>
    </t>
</templates>
