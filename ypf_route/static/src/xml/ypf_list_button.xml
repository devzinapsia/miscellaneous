<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.ListView" t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//Layout/t[@t-set-slot='control-panel-create-button']" position="inside">
            <button
                t-if="model.resModel === 'account.move'"
                type="button"
                class="btn btn-primary"
                t-on-click="() => this.onClickNuevaFacturaYPF()">
                Nueva factura de YPF
            </button>
        </xpath>
    </t>
</templates>